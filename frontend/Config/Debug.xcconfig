// CocoaPods + shared non-secret build settings for local development.
#include? "../Pods/Target Support Files/Pods-Zoji/Pods-Zoji.debug.xcconfig"
// AMap's legacy frameworks do not contain an Apple-silicon simulator slice.
// The simulator compiles the MapKit provider instead; physical devices keep AMap.
EXCLUDED_ARCHS[sdk=iphonesimulator*] =
OTHER_LDFLAGS[sdk=iphonesimulator*] =
AMAP_API_KEY =
APS_ENVIRONMENT = development
#include? "Secrets.xcconfig"
